  "type": "object",
  "additionalProperties": false,
  "required": [
    "bookId",
    "chId",
    "markId"
  ],
  "properties": {
    "bookId": {
      "type": "string",
      "minLength": 1
    },
    "chId": {
      "type": "string",
      "minLength": 1
    },
    "markId": {
      "type": "string",
      "minLength": 1
    }
  }
}
