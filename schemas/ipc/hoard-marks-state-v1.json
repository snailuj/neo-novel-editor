{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "The writer resolves or reopens a comment or highlight, version 1. Accepting or rejecting a suggestion is not offered from the window yet.",
  "type": "object",
  "additionalProperties": false,
  "required": ["bookId", "chId", "markId", "state"],
  "properties": {
    "bookId": { "type": "string", "minLength": 1 },
    "chId": { "type": "string", "minLength": 1 },
    "markId": { "type": "string", "minLength": 1 },
    "state": { "enum": ["open", "resolved"] }
  }
}
