{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A search of the library's files, version 1, from the Search pane. The open book is left out, as the window searches it itself; scope all is every book, wiki the wiki only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["text", "scope", "open", "limit", "cap"],
  "properties": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "scope": { "enum": ["all", "wiki"] },
    "open": { "type": ["string", "null"], "minLength": 1 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 500 },
    "cap": { "type": "integer", "minimum": 1, "maximum": 10000 }
  }
}
