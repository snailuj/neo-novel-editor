{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A plugin's plugin.json, version 1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "apiVersion", "renderer"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$"
    },
    "apiVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "renderer": { "$ref": "#/definitions/fileName" },
    "main": { "$ref": "#/definitions/fileName" },
    "style": { "$ref": "#/definitions/fileName" },
    "commands": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    }
  },
  "definitions": {
    "fileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*\\.(js|cjs|css)$"
    }
  }
}
